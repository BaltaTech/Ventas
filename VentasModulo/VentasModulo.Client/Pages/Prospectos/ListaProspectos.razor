@code {
    private IEnumerable<ProspectoDto>? prospectosCompletos; // Fuente original
    private IEnumerable<ProspectoDto>? prospectosFiltrados; // Fuente para la UI
    private ProspectoDto? prospectoSeleccionado;
    private bool estaCargando = false;
    private string textoBusqueda = "";
    private bool? filtroEstado = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            prospectosCompletos = await ProspectoService.ObtenerTodos();
            AplicarFiltros();
        }
        catch (Exception ex)
        {
            prospectosCompletos = new List<ProspectoDto>();
            AplicarFiltros();
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void FiltrarProspectos(ChangeEventArgs e)
    {
        textoBusqueda = e.Value?.ToString() ?? "";
        AplicarFiltros();
    }

    private void FiltrarPorEstado(bool? estado)
    {
        filtroEstado = estado;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        if (prospectosCompletos == null)
        {
            prospectosFiltrados = null;
            return;
        }

        var query = prospectosCompletos.AsEnumerable();

        // Aplicar filtro de búsqueda
        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            query = query.Where(p =>
                (p.NombreCliente?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.NombreVendedor?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.RazonSocial?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Telefono?.Contains(textoBusqueda) ?? false)
            );
        }

        // Aplicar filtro de estado
        if (filtroEstado.HasValue)
        {
            query = query.Where(p => p.Atendido == filtroEstado.Value);
        }

        prospectosFiltrados = query.ToList();
        StateHasChanged();
    }

    private void LimpiarBusqueda()
    {
        textoBusqueda = "";
        filtroEstado = null;
        AplicarFiltros();
    }

    private void MostrarDetalle(ProspectoDto p) => prospectoSeleccionado = p;

    private async Task MarcarAtendido(Guid id)
    {
        if (estaCargando) return;
        try
        {
            estaCargando = true;
            await ProspectoService.MarcarComoAtendido(id);
            await CargarDatos();
        }
        finally
        {
            estaCargando = false;
        }
    }
}