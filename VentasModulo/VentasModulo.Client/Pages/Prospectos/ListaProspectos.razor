@page "/prospectos/lista"
@rendermode InteractiveWebAssembly
@using Application.DTOs
@using Application.Interfaces
@namespace VentasModulo.Client.Pages.Prospectos
@inject IProspectoService ProspectoService
@inject NavigationManager Navigation

<div class="container-fluid mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="bi bi-wind me-2"></i>Seguimiento de Aire Acondicionado</h5>
            <button class="btn btn-success btn-sm" @onclick='() => Navigation.NavigateTo("/prospectos/registrar")'>
                <i class="bi bi-plus-circle me-1"></i> Nuevo Registro
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Cliente / Equipo</th>
                            <th>Contacto</th>
                            <th>Empresa</th>
                            <th>Vendedor</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (prospectos == null)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <div class="spinner-border spinner-border-sm text-primary me-2"></div> Cargando datos...
                                </td>
                            </tr>
                        }
                        else if (!prospectos.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No hay prospectos registrados.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in prospectos)
                            {
                                <tr>
                                    <td>@item.FechaRegistro.ToShortDateString()</td>
                                    <td>
                                        <span class="fw-bold">@item.NombreCliente</span><br />
                                        <small class="text-primary">@(item.NotasRecepcion ?? "Sin detalles de equipo")</small>
                                    </td>
                                    <td>
                                        <small><i class="bi bi-telephone"></i> @item.Telefono</small><br />
                                        <small><i class="bi bi-envelope"></i> @item.Correo</small>
                                    </td>
                                    <td><span class="badge border border-primary text-primary">@item.RazonSocial</span></td>
                                    <td>@item.NombreVendedor</td>
                                    <td>
                                        @if (item.Atendido)
                                        {
                                            <span class="badge bg-success shadow-sm">
                                                <i class="bi bi-check-circle me-1"></i> Atendido
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark shadow-sm">
                                                <i class="bi bi-clock me-1"></i> Pendiente
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!item.Atendido)
                                        {
                                            <button class="btn btn-outline-success btn-sm shadow-sm"
                                                    @onclick="() => MarcarAtendido(item.Id)"
                                                    disabled="@estaCargando">
                                                <i class="bi bi-check-lg"></i> Atender
                                            </button>
                                        }
                                        else
                                        {
                                            <i class="bi bi-patch-check-fill text-success fs-5" title="Atendido correctamente"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private IEnumerable<ProspectoDto>? prospectos;
    private bool estaCargando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            prospectos = await ProspectoService.ObtenerTodos();
        }
        catch (Exception ex)
        {
            prospectos = new List<ProspectoDto>();
            Console.WriteLine($"Error al cargar: {ex.Message}");
        }
    }

    private async Task MarcarAtendido(Guid id)
    {
        if (estaCargando) return;

        try
        {
            estaCargando = true;

            // 1. Llamada al servicio (Capa Application)
            await ProspectoService.MarcarComoAtendido(id);

            // 2. Refresco de la lista local
            await CargarDatos();

            // 3. Notificar cambio a la UI
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al marcar como atendido: {ex.Message}");
        }
        finally
        {
            estaCargando = false;
        }
    }
}