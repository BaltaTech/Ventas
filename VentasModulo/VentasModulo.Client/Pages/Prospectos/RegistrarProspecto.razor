@page "/prospectos/registrar"
@rendermode InteractiveWebAssembly
@using Application.DTOs
@using Application.Interfaces
@using Domain.Enums
@namespace VentasModulo.Client.Pages.Prospectos
@inject IProspectoService ProspectoService
@inject IUsuarioService UsuarioService
@inject IEmpresaService EmpresaService
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0">
                @* Encabezado *@
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Nuevo Registro de Cliente</h4>
                    <span class="badge bg-primary px-3">Recepción</span>
                </div>

                <div class="card-body p-4 bg-light">
                    <EditForm Model="@prospecto" OnValidSubmit="Guardar">
                        <DataAnnotationsValidator />

                        <div class="row g-4">
                            @* --- SECCIÓN: DATOS PERSONALES --- *@
                            <div class="col-md-7 border-end">
                                <h6 class="text-primary fw-bold mb-3"><i class="bi bi-person-vcard me-2"></i>Información de Contacto</h6>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Nombre del Cliente / Empresa</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                                        <InputText @bind-Value="prospecto.NombreCliente" class="form-control" placeholder="Ej: Constructora Delta" />
                                    </div>
                                    <ValidationMessage For="@(() => prospecto.NombreCliente)" class="text-danger small" />
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Teléfono</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                            <InputText @bind-Value="prospecto.Telefono" class="form-control" placeholder="664..." />
                                        </div>
                                        <ValidationMessage For="@(() => prospecto.Telefono)" class="text-danger small" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Correo</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                            <InputText @bind-Value="prospecto.Correo" class="form-control" placeholder="correo@ejemplo.com" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-success">Origen del Lead</label>
                                        <InputSelect @bind-Value="prospecto.Origen" class="form-select border-success">
                                            @foreach (var val in Enum.GetValues(typeof(OrigenProspecto)))
                                            {
                                                <option value="@val">@val</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Razón Social</label>
                                        <InputText @bind-Value="prospecto.RazonSocial" class="form-control" placeholder="Nombre para facturar" />
                                    </div>
                                </div>
                            </div>

                            @* --- SECCIÓN: ASIGNACIÓN Y NOTAS --- *@
                            <div class="col-md-5">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="text-primary fw-bold mb-0"><i class="bi bi-clipboard-check me-2"></i>Asignación</h6>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AbrirModalVendedor">
                                        <i class="bi bi-plus-circle"></i> Nuevo Vendedor
                                    </button>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Vendedor Asignado</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                        <InputSelect @bind-Value="prospecto.VendedorId" class="form-select border-primary shadow-sm">
                                            <option value="">-- Seleccionar Vendedor --</option>
                                            @if (vendedores != null)
                                            {
                                                @foreach (var v in vendedores)
                                                {
                                                    <option value="@v.Id">@v.NombreCompleto</option>
                                                }
                                            }
                                        </InputSelect>
                                    </div>
                                    <ValidationMessage For="@(() => prospecto.VendedorId)" class="text-danger small" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold text-info">
                                        <i class="bi bi-chat-left-dots-fill me-1"></i>Notas de Recepción
                                    </label>
                                    <InputTextArea @bind-Value="prospecto.NotasRecepcion"
                                                   class="form-control shadow-sm border-info"
                                                   rows="6"
                                                   placeholder="Describa el equipo solicitado: Toneladas, tipo..." />
                                </div>
                            </div>
                        </div>

                        @* --- BOTONES DE ACCIÓN --- *@
                        <div class="d-flex justify-content-end gap-2 mt-4 border-top pt-3">
                            <button type="button" class="btn btn-light border px-4" @onclick='() => Navigation.NavigateTo("/prospectos/lista")'>
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </button>
                            <button type="submit" class="btn btn-success px-5 shadow" disabled="@enviando">
                                @if (enviando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-save2-fill me-2"></i>Finalizar Registro</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- MODAL PARA NUEVO VENDEDOR --- *@
@if (mostrarModalVendedor)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Registrar Nuevo Vendedor</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalVendedor"></button>
                </div>
                <EditForm Model="@nuevoUsuario" OnValidSubmit="GuardarVendedor">
                    <div class="modal-body">
                        @* CLAVE: Selector de Empresa para evitar error de FK *@
                        <div class="mb-3">
                            <label class="form-label fw-bold">Asignar a Empresa (Razón Social)</label>
                            <InputSelect @bind-Value="nuevoUsuario.EmpresaId" class="form-select border-primary">
                                <option value="0">-- Seleccione Empresa --</option>
                                @if (listaEmpresas != null)
                                {
                                    @foreach (var emp in listaEmpresas)
                                    {
                                        <option value="@emp.Id">@emp.RazonSocial</option>
                                    }
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre Completo</label>
                            <InputText @bind-Value="nuevoUsuario.NombreCompleto" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Correo Electrónico</label>
                            <InputText @bind-Value="nuevoUsuario.CorreoElectronico" class="form-control" />
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalVendedor">Cerrar</button>
                        <button type="submit" class="btn btn-primary">Guardar Vendedor</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private ProspectoDto prospecto = new ProspectoDto();
    private UsuarioDto nuevoUsuario = new UsuarioDto();
    private IEnumerable<UsuarioDto>? vendedores;
    private IEnumerable<EmpresaDto>? listaEmpresas;
    private bool enviando = false;
    private bool mostrarModalVendedor = false;

    protected override async Task OnInitializedAsync()
    {
        prospecto.FechaRegistro = DateTime.Now;
        prospecto.Atendido = false;
        prospecto.Origen = OrigenProspecto.LlamadaTelefonica;
        prospecto.EmpresaId = 1;

        await CargarVendedores();
        await CargarEmpresas();
    }

    private async Task CargarVendedores()
    {
        try
        {
            vendedores = await UsuarioService.ObtenerVendedoresActivos();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar vendedores: {ex.Message}");
        }
    }

    private async Task CargarEmpresas()
    {
        try
        {
            // Asumiendo que tu IEmpresaService tiene este método para cargar las 2 razones sociales
            listaEmpresas = await EmpresaService.ObtenerEmpresasHabilitadas();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar empresas: {ex.Message}");
        }
    }

    private async Task Guardar()
    {
        if (enviando) return;
        try
        {
            enviando = true;
            prospecto.FechaRegistro = DateTime.Now;
            await ProspectoService.Crear(prospecto);
            Navigation.NavigateTo("/prospectos/lista");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al intentar guardar prospecto: {ex.Message}");
        }
        finally
        {
            enviando = false;
        }
    }

    private void AbrirModalVendedor()
    {
        nuevoUsuario = new UsuarioDto { EmpresaId = 1 }; // Valor por defecto
        mostrarModalVendedor = true;
    }

    private void CerrarModalVendedor() => mostrarModalVendedor = false;

    private async Task GuardarVendedor()
    {
        if (nuevoUsuario.EmpresaId == 0)
        {
            Console.WriteLine("Debe seleccionar una empresa válida.");
            return;
        }

        try
        {
            // El servidor ahora recibirá el EmpresaId correcto, evitando el error 400
            await UsuarioService.CrearVendedor(nuevoUsuario);

            mostrarModalVendedor = false;
            nuevoUsuario = new UsuarioDto();

            await CargarVendedores();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar vendedor: {ex.Message}");
        }
    }
}