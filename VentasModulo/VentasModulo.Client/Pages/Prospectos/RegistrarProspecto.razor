@page "/prospectos/registrar"
@rendermode InteractiveWebAssembly
@using Application.DTOs
@using Application.Interfaces
@using Domain.Enums
@namespace VentasModulo.Client.Pages.Prospectos
@inject IProspectoService ProspectoService
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0">
                @* Encabezado con estilo industrial/HVAC *@
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Nuevo Registro de Cliente</h4>
                    <span class="badge bg-primary px-3">Recepción</span>
                </div>

                <div class="card-body p-4 bg-light">
                    <EditForm Model="@prospecto" OnValidSubmit="Guardar">
                        <DataAnnotationsValidator />

                        <div class="row g-4">
                            @* --- SECCIÓN: DATOS PERSONALES --- *@
                            <div class="col-md-7 border-end">
                                <h6 class="text-primary fw-bold mb-3"><i class="bi bi-person-vcard me-2"></i>Información de Contacto</h6>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Nombre del Cliente / Empresa</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                                        <InputText @bind-Value="prospecto.NombreCliente" class="form-control" placeholder="Ej: Constructora Delta" />
                                    </div>
                                    <ValidationMessage For="@(() => prospecto.NombreCliente)" class="text-danger small" />
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Teléfono</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                            <InputText @bind-Value="prospecto.Telefono" class="form-control" placeholder="664..." />
                                        </div>
                                        <ValidationMessage For="@(() => prospecto.Telefono)" class="text-danger small" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Correo</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                            <InputText @bind-Value="prospecto.Correo" class="form-control" placeholder="correo@ejemplo.com" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold text-success">Origen del Lead</label>
                                        <InputSelect @bind-Value="prospecto.Origen" class="form-select border-success">
                                            @foreach (var val in Enum.GetValues(typeof(OrigenProspecto)))
                                            {
                                                <option value="@val">@val</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Razón Social</label>
                                        <InputText @bind-Value="prospecto.RazonSocial" class="form-control" placeholder="Nombre para facturar" />
                                    </div>
                                </div>
                            </div>

                            @* --- SECCIÓN: ASIGNACIÓN Y NOTAS --- *@
                            <div class="col-md-5">
                                <h6 class="text-primary fw-bold mb-3"><i class="bi bi-clipboard-check me-2"></i>Asignación Interna</h6>

                                <div class="mb-3">
                                    <label class="form-label fw-bold">Vendedor Asignado</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                        <InputText @bind-Value="prospecto.NombreVendedor" class="form-control" placeholder="Nombre del vendedor" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold text-info">
                                        <i class="bi bi-chat-left-dots-fill me-1"></i>Notas de Recepción / Requerimiento
                                    </label>
                                    <InputTextArea @bind-Value="prospecto.NotasRecepcion"
                                                   class="form-control shadow-sm border-info"
                                                   rows="6"
                                                   placeholder="Describa el equipo solicitado: Toneladas, tipo (Inverter, Paquete), marca de preferencia, urgencia de instalación..." />
                                    <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>Esta nota es vital para el vendedor.</div>
                                </div>
                            </div>
                        </div>

                        @* --- BOTONES DE ACCIÓN --- *@
                        <div class="d-flex justify-content-end gap-2 mt-4 border-top pt-3">
                            <button type="button" class="btn btn-light border px-4" @onclick='() => Navigation.NavigateTo("/prospectos/lista")'>
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </button>
                            <button type="submit" class="btn btn-success px-5 shadow" disabled="@enviando">
                                @if (enviando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-save2-fill me-2"></i>Finalizar Registro</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ProspectoDto prospecto = new ProspectoDto();
    private bool enviando = false;

    protected override void OnInitialized()
    {
        // Inicializar valores por defecto para evitar nulos en el DTO
        prospecto.FechaRegistro = DateTime.Now;
        prospecto.Atendido = false;
        prospecto.Origen = OrigenProspecto.LlamadaTelefonica; // O el valor que prefieras por defecto

        // El EmpresaId lo puedes dejar en 1 o manejarlo según tu lógica
        prospecto.EmpresaId = 1;
    }

    private async Task Guardar()
    {
        if (enviando) return;

        try
        {
            enviando = true;

            // Aseguramos que la fecha sea la del momento exacto del clic
            prospecto.FechaRegistro = DateTime.Now;

            await ProspectoService.Crear(prospecto);

            // Regresamos a la tabla que ya tienes funcionando
            Navigation.NavigateTo("/prospectos/lista");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al intentar guardar: {ex.Message}");
            // Aquí podrías agregar una notificación visual de error si tienes alguna librería de Toast
        }
        finally
        {
            enviando = false;
        }
    }
}