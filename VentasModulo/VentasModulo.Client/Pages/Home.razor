@page "/"
@rendermode InteractiveWebAssembly
@using Application.DTOs
@using Application.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IProspectoService ProspectoService
@inject NavigationManager Navigation

<PageTitle>Dashboard | Ventas HVAC</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (estaCargando)
        {
            <div class="loading-container">
                <div class="loading-spinner"></div>
                <p>Cargando indicadores corporativos...</p>
            </div>
        }
        else
        {
            <div class="dashboard-container">
                <div class="dashboard-wrapper">
                    <!-- HEADER -->
                    <div class="dashboard-header">
                        <div class="header-content">
                            <div class="title-section">
                                <div class="title-badge">
                                    <i class="bi bi-wind"></i>
                                    <span>VENTAS HVAC - MÓDULO DE PROSPECTOS</span>
                                </div>
                                <div class="title-main">
                                    <h1>Panel de Control Comercial</h1>
                                    <span class="version-tag">v2.0.0</span>
                                </div>
                                <div class="title-sub">
                                    <i class="bi bi-bar-chart-line"></i>
                                    <span>Monitoreo en tiempo real del pipeline de ventas</span>
                                </div>
                            </div>

                            <div class="date-display">
                                <span class="day">@DateTime.Now.ToString("dd")</span>
                                <div class="month-year">
                                    <span>@DateTime.Now.ToString("MMM").ToUpper()</span>
                                    <span>@DateTime.Now.ToString("yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI CARDS -->
                    <div class="kpi-grid">
                        <div class="kpi-card">
                            <div class="kpi-icon pending">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                            <div class="kpi-content">
                                <div class="kpi-label">Pendientes por atender</div>
                                <div class="kpi-value">@totalPendientes</div>
                                <span class="kpi-trend">
                                    <i class="bi bi-clock"></i>
                                    Requieren acción
                                </span>
                            </div>
                        </div>

                        <div class="kpi-card">
                            <div class="kpi-icon completed">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div class="kpi-content">
                                <div class="kpi-label">Prospectos atendidos</div>
                                <div class="kpi-value">@totalAtendidos</div>
                                <span class="kpi-trend">
                                    <i class="bi bi-check-lg"></i>
                                    Conversión exitosa
                                </span>
                            </div>
                        </div>

                        <div class="kpi-card">
                            <div class="kpi-icon total">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="kpi-content">
                                <div class="kpi-label">Total leads registrados</div>
                                <div class="kpi-value">@totalGeneral</div>
                                <span class="kpi-trend">
                                    <i class="bi bi-database"></i>
                                    Historial completo
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- MÉTRICAS DETALLADAS -->
                    @if (totalGeneral > 0)
                    {
                        var porcentajeAtendidos = (totalAtendidos * 100) / totalGeneral;

                        <div class="metrics-section">
                            <div class="section-header">
                                <h2>
                                    <i class="bi bi-graph-up-arrow"></i>
                                    Métricas de rendimiento
                                </h2>
                                <a class="view-all-link" href="prospectos/lista">
                                    Ver todos los registros
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>

                            <div class="metrics-grid">
                                <div class="progress-card">
                                    <div class="progress-header">
                                        <span class="progress-title">Tasa de conversión</span>
                                        <span class="progress-percent">@porcentajeAtendidos%</span>
                                    </div>
                                    <div class="progress-bar-container">
                                        <div class="progress-bar" style="width: @(porcentajeAtendidos)%;"></div>
                                    </div>
                                    <div class="progress-stats">
                                        <span>@totalAtendidos atendidos</span>
                                        <span>@totalPendientes pendientes</span>
                                    </div>
                                </div>

                                <div class="summary-card">
                                    <span class="progress-title">Resumen rápido</span>
                                    <ul class="summary-list">
                                        <li class="summary-item">
                                            <span class="summary-dot @(totalPendientes > 0 ? "pending" : "")"></span>
                                            <div class="summary-info">
                                                <div class="summary-name">Tasa de éxito</div>
                                                <div class="summary-date">@porcentajeAtendidos% de conversión</div>
                                            </div>
                                        </li>
                                        <li class="summary-item">
                                            <span class="summary-dot"></span>
                                            <div class="summary-info">
                                                <div class="summary-name">Leads activos</div>
                                                <div class="summary-date">@totalGeneral registros en sistema</div>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- ACCIONES PRINCIPALES -->
                    <div class="actions-section">
                        <div class="section-header">
                            <h2>
                                <i class="bi bi-lightning-charge-fill"></i>
                                Acciones rápidas
                            </h2>
                        </div>

                        <div class="actions-grid">
                            <div class="action-card" @onclick='() => Navigation.NavigateTo("prospectos/lista")'>
                                <div class="action-icon-wrapper">
                                    <div class="action-icon">
                                        <i class="bi bi-list-stars"></i>
                                    </div>
                                    <h3 class="action-title">Seguimiento de prospectos</h3>
                                </div>
                                <p class="action-description">
                                    Gestiona la lista completa de clientes, filtra por estado y da seguimiento a cada caso.
                                </p>
                                <div class="action-meta">
                                    <span class="action-badge">
                                        <i class="bi bi-funnel"></i>
                                        Filtros avanzados
                                    </span>
                                    <span class="action-link">
                                        Acceder <i class="bi bi-arrow-right"></i>
                                    </span>
                                </div>
                            </div>

                            <div class="action-card" @onclick='() => Navigation.NavigateTo("prospectos/registrar")'>
                                <div class="action-icon-wrapper">
                                    <div class="action-icon primary">
                                        <i class="bi bi-person-plus-fill"></i>
                                    </div>
                                    <h3 class="action-title">Registro de nuevo lead</h3>
                                </div>
                                <p class="action-description">
                                    Captura los datos de un nuevo prospecto, asigna vendedor y documenta requerimientos.
                                </p>
                                <div class="action-meta">
                                    <span class="action-badge">
                                        <i class="bi bi-lightning-charge"></i>
                                        Inmediato
                                    </span>
                                    <span class="action-link">
                                        Crear <i class="bi bi-arrow-right"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="auth-wrapper">
            <div class="auth-card-premium">
                <div class="auth-icon-circle">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h2>Acceso Protegido</h2>
                <p>Identifícate para gestionar el pipeline de ventas de Ventas Aire y Clima.</p>
                <button class="btn-premium-lg" @onclick='() => Navigation.NavigateTo("login")'>
                    Continuar al Inicio de Sesión
                </button>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private int totalPendientes;
    private int totalAtendidos;
    private int totalGeneral;
    private bool estaCargando = true;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthStateTask != null)
            {
                var authState = await AuthStateTask;
                var user = authState.User;

                if (user.Identity != null && user.Identity.IsAuthenticated)
                {
                    var prospectos = await ProspectoService.ObtenerTodos();
                    if (prospectos != null)
                    {
                        var lista = prospectos.ToList();
                        totalGeneral = lista.Count;
                        totalAtendidos = lista.Count(p => p.Atendido);
                        totalPendientes = totalGeneral - totalAtendidos;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error de seguridad o carga: {ex.Message}");
        }
        finally
        {
            estaCargando = false;
        }
    }
}

<style>
    /* ===== ESTILOS PARA AUTENTICACIÓN ===== */
    .auth-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #f8fafc;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
    }

    .auth-card-premium {
        text-align: center;
        padding: 3rem;
        border-radius: 32px;
        background: white;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        max-width: 440px;
        width: 90%;
    }

    .auth-icon-circle {
        width: 88px;
        height: 88px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        font-size: 2.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        margin: 0 auto 1.8rem;
        box-shadow: 0 20px 30px -10px rgba(79, 70, 229, 0.4);
    }

    .auth-card-premium h2 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.8rem;
    }

    .auth-card-premium p {
        color: #475569;
        margin-bottom: 2rem;
        font-size: 1rem;
        line-height: 1.5;
    }

    .btn-premium-lg {
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 14px;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

        .btn-premium-lg:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 30px -10px rgba(79, 70, 229, 0.5);
        }

    /* ===== VARIABLES Y ESTILOS GLOBALES DEL DASHBOARD ===== */
    :root {
        --primary-dark: #0f172a;
        --primary: #1e293b;
        --accent: #2563eb;
        --accent-light: #3b82f6;
        --success: #10b981;
        --warning: #f59e0b;
        --surface: #ffffff;
        --background: #f1f5f9;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-tertiary: #64748b;
        --border: #e2e8f0;
        --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
        --shadow-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    }

    body {
        background: var(--background);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
    }

    .dashboard-container {
        background: var(--background);
        min-height: 100vh;
        padding: 2rem;
    }

    .dashboard-wrapper {
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ===== HEADER ===== */
    .dashboard-header {
        margin-bottom: 2.5rem;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
        background: white;
        padding: 1.5rem 2rem;
        border-radius: 24px;
        box-shadow: var(--shadow-card);
        border: 1px solid var(--border);
    }

    .title-section {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .title-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(37, 99, 235, 0.08);
        padding: 0.4rem 1rem;
        border-radius: 100px;
        color: var(--accent);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        width: fit-content;
        border: 1px solid rgba(37, 99, 235, 0.1);
    }

        .title-badge i {
            font-size: 0.8rem;
        }

    .title-main {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .title-main h1 {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.02em;
            margin: 0;
            line-height: 1.2;
        }

    .version-tag {
        background: var(--background);
        padding: 0.2rem 0.8rem;
        border-radius: 100px;
        font-size: 0.7rem;
        color: var(--text-secondary);
        border: 1px solid var(--border);
        font-weight: 500;
    }

    .title-sub {
        color: var(--text-secondary);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .title-sub i {
            color: var(--accent);
        }

    .date-display {
        background: var(--background);
        padding: 0.6rem 1.5rem;
        border-radius: 100px;
        display: flex;
        align-items: center;
        gap: 1rem;
        border: 1px solid var(--border);
    }

        .date-display .day {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1;
        }

        .date-display .month-year {
            display: flex;
            flex-direction: column;
            font-size: 0.7rem;
            color: var(--text-secondary);
            border-left: 1px solid var(--border);
            padding-left: 1rem;
        }

            .date-display .month-year span:first-child {
                font-weight: 600;
                color: var(--text-primary);
                text-transform: uppercase;
            }

    /* ===== LOADING ===== */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 400px;
        gap: 1rem;
        background: white;
        border-radius: 32px;
        padding: 3rem;
        box-shadow: var(--shadow-card);
    }

    .loading-spinner {
        width: 48px;
        height: 48px;
        border: 3px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* ===== KPI GRID ===== */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .kpi-card {
        background: white;
        border-radius: 24px;
        padding: 1.8rem;
        box-shadow: var(--shadow-card);
        border: 1px solid var(--border);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

        .kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
            border-color: var(--accent-light);
        }

    .kpi-icon {
        width: 64px;
        height: 64px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        flex-shrink: 0;
    }

        .kpi-icon.pending {
            background: rgba(245, 158, 11, 0.12);
            color: var(--warning);
        }

        .kpi-icon.completed {
            background: rgba(16, 185, 129, 0.12);
            color: var(--success);
        }

        .kpi-icon.total {
            background: rgba(37, 99, 235, 0.12);
            color: var(--accent);
        }

    .kpi-content {
        flex: 1;
    }

    .kpi-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-tertiary);
        margin-bottom: 0.25rem;
        font-weight: 600;
    }

    .kpi-value {
        font-size: 2.8rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
        margin-bottom: 0.2rem;
    }

    .kpi-trend {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.7rem;
        padding: 0.25rem 1rem;
        border-radius: 100px;
        background: var(--background);
        color: var(--text-secondary);
        border: 1px solid var(--border);
    }

    /* ===== MÉTRICAS SECTION ===== */
    .metrics-section {
        margin-bottom: 2rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.2rem;
        padding: 0 0.25rem;
    }

        .section-header h2 {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
        }

            .section-header h2 i {
                color: var(--accent);
            }

    .view-all-link {
        color: var(--accent);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        transition: gap 0.2s ease;
        padding: 0.4rem 1rem;
        border-radius: 100px;
        background: white;
        border: 1px solid var(--border);
    }

        .view-all-link:hover {
            gap: 0.6rem;
            background: var(--accent);
            color: white;
            border-color: var(--accent);
        }

    .metrics-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
    }

    .progress-card {
        background: white;
        border-radius: 24px;
        padding: 1.8rem;
        box-shadow: var(--shadow-card);
        border: 1px solid var(--border);
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.2rem;
    }

    .progress-title {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    .progress-percent {
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent);
        line-height: 1;
    }

    .progress-bar-container {
        height: 8px;
        background: var(--border);
        border-radius: 100px;
        overflow: hidden;
        margin: 1rem 0;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, var(--accent), var(--accent-light));
        border-radius: 100px;
        transition: width 0.5s ease;
    }

    .progress-stats {
        display: flex;
        justify-content: space-between;
        color: var(--text-secondary);
        font-size: 0.8rem;
    }

    .summary-card {
        background: white;
        border-radius: 24px;
        padding: 1.8rem;
        box-shadow: var(--shadow-card);
        border: 1px solid var(--border);
    }

    .summary-list {
        list-style: none;
        margin: 1.2rem 0 0 0;
        padding: 0;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.8rem 0;
        border-bottom: 1px solid var(--border);
    }

        .summary-item:last-child {
            border-bottom: none;
        }

    .summary-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
    }

        .summary-dot.pending {
            background: var(--warning);
        }

    .summary-info {
        flex: 1;
    }

    .summary-name {
        font-weight: 500;
        color: var(--text-primary);
        font-size: 0.85rem;
        margin-bottom: 0.1rem;
    }

    .summary-date {
        font-size: 0.7rem;
        color: var(--text-tertiary);
    }

    /* ===== ACCIONES RÁPIDAS ===== */
    .actions-section {
        margin-top: 2rem;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .action-card {
        background: white;
        border-radius: 24px;
        padding: 1.8rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

        .action-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
            border-color: var(--accent);
        }

    .action-icon-wrapper {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .action-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
    }

        .action-icon.primary {
            background: linear-gradient(135deg, var(--accent), var(--accent-light));
        }

    .action-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .action-description {
        color: var(--text-secondary);
        font-size: 0.85rem;
        line-height: 1.5;
        margin: 0;
    }

    .action-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .action-badge {
        background: var(--background);
        padding: 0.25rem 1rem;
        border-radius: 100px;
        font-size: 0.7rem;
        color: var(--text-secondary);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .action-link {
        color: var(--accent);
        font-weight: 500;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin-left: auto;
        text-decoration: none;
    }

        .action-link i {
            transition: transform 0.2s ease;
        }

    .action-card:hover .action-link i {
        transform: translateX(4px);
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .kpi-grid,
        .actions-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .metrics-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 1rem;
        }

        .header-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .kpi-grid,
        .actions-grid {
            grid-template-columns: 1fr;
        }

        .title-main h1 {
