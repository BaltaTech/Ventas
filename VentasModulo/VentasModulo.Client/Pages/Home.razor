@page "/"
@using Application.DTOs
@using Application.Interfaces
@rendermode InteractiveWebAssembly
@inject IProspectoService ProspectoService
@inject NavigationManager Navigation

<PageTitle>Dashboard | Ventas HVAC</PageTitle>

<style>
    /* ===== VARIABLES CSS ===== */
    :root {
        --primary-color: #0f172a;
        --primary-light: #1e293b;
        --accent-color: #2563eb;
        --accent-light: #3b82f6;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --surface-color: #ffffff;
        --background-color: #f8fafc;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-tertiary: #64748b;
        --border-color: #e2e8f0;
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    }

    /* ===== ESTILOS BASE ===== */
    .dashboard-container {
        background: var(--background-color);
        min-height: 100vh;
        padding: 2rem 1rem;
        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .dashboard-wrapper {
        max-width: 1440px;
        margin: 0 auto;
    }

    /* ===== HEADER ===== */
    .dashboard-header {
        margin-bottom: 2.5rem;
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .title-section {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .title-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(37, 99, 235, 0.1);
        padding: 0.4rem 1rem;
        border-radius: 100px;
        color: var(--accent-color);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        width: fit-content;
    }

        .title-badge i {
            font-size: 0.85rem;
        }

    .title-main {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

        .title-main h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.02em;
            line-height: 1.2;
            margin: 0;
        }

    .version-tag {
        background: var(--surface-color);
        padding: 0.2rem 0.8rem;
        border-radius: 100px;
        font-size: 0.7rem;
        color: var(--text-secondary);
        border: 1px solid var(--border-color);
        font-weight: 500;
    }

    .title-sub {
        color: var(--text-secondary);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .title-sub i {
            color: var(--accent-color);
        }

    .date-display {
        background: var(--surface-color);
        padding: 0.75rem 1.5rem;
        border-radius: 100px;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
    }

        .date-display .day {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1;
        }

        .date-display .month-year {
            display: flex;
            flex-direction: column;
            font-size: 0.75rem;
            color: var(--text-secondary);
            border-left: 1px solid var(--border-color);
            padding-left: 1rem;
        }

            .date-display .month-year span:first-child {
                font-weight: 600;
                color: var(--text-primary);
                text-transform: uppercase;
            }

    /* ===== LOADING SKELETON ===== */
    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 300px;
    }

    .loading-spinner {
        width: 50px;
        height: 50px;
        border: 3px solid var(--border-color);
        border-top-color: var(--accent-color);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* ===== KPI CARDS ===== */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }

    .kpi-card {
        background: var(--surface-color);
        border-radius: 24px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

        .kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

    .kpi-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex-shrink: 0;
    }

        .kpi-icon.pending {
            background: rgba(245, 158, 11, 0.1);
            color: var(--warning-color);
        }

        .kpi-icon.completed {
            background: rgba(16, 185, 129, 0.1);
            color: var(--success-color);
        }

        .kpi-icon.total {
            background: rgba(37, 99, 235, 0.1);
            color: var(--accent-color);
        }

    .kpi-content {
        flex: 1;
    }

    .kpi-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-tertiary);
        margin-bottom: 0.25rem;
        font-weight: 600;
    }

    .kpi-value {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .kpi-trend {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.7rem;
        padding: 0.2rem 0.8rem;
        border-radius: 100px;
        background: var(--background-color);
        color: var(--text-secondary);
    }

        .kpi-trend i {
            font-size: 0.65rem;
        }

    /* ===== MÉTRICAS SECTION ===== */
    .metrics-section {
        margin-bottom: 2.5rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.2rem;
    }

        .section-header h2 {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin: 0;
        }

            .section-header h2 i {
                color: var(--accent-color);
            }

    .view-all-link {
        color: var(--accent-color);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        transition: gap 0.3s ease;
    }

        .view-all-link:hover {
            gap: 0.6rem;
            color: var(--accent-light);
        }

    .metrics-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
    }

    /* Tarjeta de progreso */
    .progress-card {
        background: var(--surface-color);
        border-radius: 24px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .progress-title {
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    .progress-percent {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--accent-color);
    }

    .progress-bar-container {
        height: 8px;
        background: var(--border-color);
        border-radius: 100px;
        overflow: hidden;
        margin: 1rem 0;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, var(--accent-color), var(--accent-light));
        border-radius: 100px;
        width: 0%;
        transition: width 0.5s ease;
    }

    .progress-stats {
        display: flex;
        justify-content: space-between;
        color: var(--text-secondary);
        font-size: 0.8rem;
    }

    /* Tarjeta de resumen */
    .summary-card {
        background: var(--surface-color);
        border-radius: 24px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
    }

    .summary-list {
        list-style: none;
        margin: 1rem 0 0 0;
        padding: 0;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.7rem 0;
        border-bottom: 1px solid var(--border-color);
    }

        .summary-item:last-child {
            border-bottom: none;
        }

    .summary-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent-color);
    }

        .summary-dot.pending {
            background: var(--warning-color);
        }

    .summary-info {
        flex: 1;
    }

    .summary-name {
        font-weight: 500;
        color: var(--text-primary);
        font-size: 0.85rem;
    }

    .summary-date {
        font-size: 0.7rem;
        color: var(--text-tertiary);
    }

    /* ===== TARJETAS DE ACCIÓN ===== */
    .actions-section {
        margin-top: 1rem;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }

    .action-card {
        background: var(--surface-color);
        border-radius: 24px;
        padding: 1.8rem;
        cursor: pointer;
        transition: all 0.3s ease;
        border: 1px solid var(--border-color);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

        .action-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
        }

    .action-icon-wrapper {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .action-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        background: linear-gradient(145deg, var(--primary-color), var(--primary-light));
        color: white;
    }

        .action-icon.primary {
            background: linear-gradient(145deg, var(--accent-color), var(--accent-light));
        }

    .action-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .action-description {
        color: var(--text-secondary);
        font-size: 0.85rem;
        line-height: 1.5;
        margin: 0.25rem 0;
    }

    .action-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 0.5rem;
    }

    .action-badge {
        background: var(--background-color);
        padding: 0.2rem 0.8rem;
        border-radius: 100px;
        font-size: 0.7rem;
        color: var(--text-secondary);
        border: 1px solid var(--border-color);
    }

    .action-link {
        color: var(--accent-color);
        font-weight: 500;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        margin-left: auto;
        text-decoration: none;
    }

        .action-link i {
            transition: transform 0.3s ease;
        }

    .action-card:hover .action-link i {
        transform: translateX(4px);
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 1rem;
        }

        .header-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .title-main h1 {
            font-size: 1.6rem;
        }

        .metrics-grid {
            grid-template-columns: 1fr;
        }

        .kpi-value {
            font-size: 2rem;
        }

        .date-display {
            width: 100%;
            justify-content: center;
        }
    }

    /* ===== UTILIDADES ===== */
    .text-center {
        text-align: center;
    }

    .mt-2 {
        margin-top: 0.5rem;
    }

    .mb-2 {
        margin-bottom: 0.5rem;
    }
</style>

<div class="dashboard-container">
    <div class="dashboard-wrapper">
        <!-- HEADER -->
        <div class="dashboard-header">
            <div class="header-content">
                <div class="title-section">
                    <div class="title-badge">
                        <i class="bi bi-wind"></i>
                        <span>Ventas HVAC - Módulo de Prospectos</span>
                    </div>
                    <div class="title-main">
                        <h1>Panel de Control Comercial</h1>
                        <span class="version-tag">v2.0.0</span>
                    </div>
                    <div class="title-sub">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Monitoreo en tiempo real del pipeline de ventas</span>
                    </div>
                </div>

                <div class="date-display">
                    <span class="day">@DateTime.Now.ToString("dd")</span>
                    <div class="month-year">
                        <span>@DateTime.Now.ToString("MMM")</span>
                        <span>@DateTime.Now.ToString("yyyy")</span>
                    </div>
                </div>
            </div>
        </div>

        @if (estaCargando)
        {
            <div class="loading-container">
                <div class="loading-spinner"></div>
            </div>
        }
        else
        {
            <!-- KPI CARDS -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-icon pending">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Pendientes por atender</div>
                        <div class="kpi-value">@totalPendientes</div>
                        <span class="kpi-trend">
                            <i class="bi bi-clock"></i>
                            Requieren acción
                        </span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon completed">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Prospectos atendidos</div>
                        <div class="kpi-value">@totalAtendidos</div>
                        <span class="kpi-trend">
                            <i class="bi bi-check-lg"></i>
                            Conversión exitosa
                        </span>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon total">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="kpi-content">
                        <div class="kpi-label">Total leads registrados</div>
                        <div class="kpi-value">@totalGeneral</div>
                        <span class="kpi-trend">
                            <i class="bi bi-database"></i>
                            Historial completo
                        </span>
                    </div>
                </div>
            </div>

            <!-- MÉTRICAS DETALLADAS -->
            @if (totalGeneral > 0)
            {
                var porcentajeAtendidos = (totalAtendidos * 100) / totalGeneral;

                <div class="metrics-section">
                    <div class="section-header">
                        <h2>
                            <i class="bi bi-graph-up"></i>
                            Métricas de rendimiento
                        </h2>
                        <a class="view-all-link" href="prospectos/lista">
                            Ver todos los registros
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    <div class="metrics-grid">
                        <div class="progress-card">
                            <div class="progress-header">
                                <span class="progress-title">Tasa de conversión</span>
                                <span class="progress-percent">@porcentajeAtendidos%</span>
                            </div>
                            <div class="progress-bar-container">
                                <div class="progress-bar" style="width: @(porcentajeAtendidos)%;"></div>
                            </div>
                            <div class="progress-stats">
                                <span>@totalAtendidos atendidos</span>
                                <span>@totalPendientes pendientes</span>
                            </div>
                        </div>

                        <div class="summary-card">
                            <span class="progress-title">Resumen rápido</span>
                            <ul class="summary-list">
                                <li class="summary-item">
                                    <span class="summary-dot @(totalPendientes > 0 ? "pending" : "")"></span>
                                    <div class="summary-info">
                                        <div class="summary-name">Tasa de éxito</div>
                                        <div class="summary-date">@porcentajeAtendidos% de conversión</div>
                                    </div>
                                </li>
                                <li class="summary-item">
                                    <span class="summary-dot"></span>
                                    <div class="summary-info">
                                        <div class="summary-name">Leads activos</div>
                                        <div class="summary-date">@totalGeneral registros en sistema</div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            }

            <!-- ACCIONES PRINCIPALES -->
            <div class="actions-section">
                <div class="section-header">
                    <h2>
                        <i class="bi bi-lightning"></i>
                        Acciones rápidas
                    </h2>
                </div>

                <div class="actions-grid">
                    <div class="action-card" @onclick='() => Navigation.NavigateTo("prospectos/lista")'>
                        <div class="action-icon-wrapper">
                            <div class="action-icon">
                                <i class="bi bi-list-stars"></i>
                            </div>
                            <h3 class="action-title">Seguimiento de prospectos</h3>
                        </div>
                        <p class="action-description">
                            Gestiona la lista completa de clientes, filtra por estado y da seguimiento a cada caso.
                        </p>
                        <div class="action-meta">
                            <span class="action-badge">
                                <i class="bi bi-funnel me-1"></i>
                                Filtros avanzados
                            </span>
                            <span class="action-link">
                                Acceder <i class="bi bi-arrow-right"></i>
                            </span>
                        </div>
                    </div>

                    <div class="action-card" @onclick='() => Navigation.NavigateTo("prospectos/registrar")'>
                        <div class="action-icon-wrapper">
                            <div class="action-icon primary">
                                <i class="bi bi-person-plus"></i>
                            </div>
                            <h3 class="action-title">Registro de nuevo lead</h3>
                        </div>
                        <p class="action-description">
                            Captura los datos de un nuevo prospecto, asigna vendedor y documenta requerimientos.
                        </p>
                        <div class="action-meta">
                            <span class="action-badge">
                                <i class="bi bi-lightning-charge me-1"></i>
                                Inmediato
                            </span>
                            <span class="action-link">
                                Crear <i class="bi bi-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private int totalPendientes;
    private int totalAtendidos;
    private int totalGeneral;
    private bool estaCargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var prospectos = await ProspectoService.ObtenerTodos();
            if (prospectos != null)
            {
                totalGeneral = prospectos.Count();
                totalAtendidos = prospectos.Count(p => p.Atendido);
                totalPendientes = totalGeneral - totalAtendidos;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando estadísticas: {ex.Message}");
        }
        finally
        {
            estaCargando = false;
        }
    }
}