@using Microsoft.AspNetCore.Components.Web
@using VentasModulo.Client
@using VentasModulo.Client.Layout

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="VentasModulo.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

    @* Sincronizamos el HeadOutlet con el mismo modo de renderizado de Routes *@
    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body>
    @* EXPLICACIÓN SENIOR: 
       Al desactivar 'prerender', el Servidor no intenta validar la autorización 
       ni instanciar servicios del cliente antes de tiempo. 
       Esto permite que el navegador (WASM) tome el control total, lea el LocalStorage 
       y decida si mostrar el Home o redirigir al Login sin lanzar errores 401.
    *@
    <Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />

    <script src="_framework/blazor.web.js"></script>
</body>

</html>